<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:padding="8dp"
        app:titleTextColor="@color/black">

        <!-- Menu button aligned left -->
        <ImageButton
            android:id="@+id/menuBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_menu"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            app:tint="@color/black"
            android:layout_gravity="start"/>

        <!-- Logo and Title next to menu -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="start"
            android:layout_marginStart="8dp">

            <ImageView
                android:id="@+id/dashboardLogo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/barber_logo"
                android:contentDescription="Gentlemen's Barber Logo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gentlemen's Barber"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>
        </LinearLayout>

        <!-- Profile button aligned right -->
        <ImageButton
            android:id="@+id/profileBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_profile"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Profile"
            app:tint="@color/black"
            android:layout_gravity="end"/>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Welcome Card styled like loyalty card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/welcomeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        android:layout_margin="16dp"
        android:layout_below="@id/topAppBar">

        <!-- Gradient background container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/black"
            android:padding="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gentlemens Card"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>

            <!-- User Name -->
            <TextView
                android:id="@+id/welcomeUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_centerInParent="true"/>

            <!-- Rewards clickable line -->
            <TextView
                android:id="@+id/rewardsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You are officially a Gentlemen's Barber Member"
                android:textSize="14sp"
                android:textColor="@color/beige"
                android:layout_below="@id/welcomeUser"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"/>

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- Dashboard Boards -->
    <LinearLayout
        android:id="@+id/dashboardBoards"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_below="@id/welcomeCard"
        android:layout_marginTop="16dp"
        android:padding="8dp">

        <!-- Upcoming Appointments -->
        <androidx.cardview.widget.CardView
            android:id="@+id/upcomingAppointmentsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:layout_margin="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Appointments"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upcomingAppointmentsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="You have 0 appointments"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Total Spend -->
        <androidx.cardview.widget.CardView
            android:id="@+id/totalSpendCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:layout_margin="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Spend"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/totalSpendText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R0"
                    android:textColor="#666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Services Title -->
    <TextView
        android:id="@+id/servicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Our Services"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_below="@id/dashboardBoards"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"/>

    <!-- Scrollable Services -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/servicesTitle"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            android:layout_margin="16dp"
            android:padding="12dp">

            <GridLayout
                android:id="@+id/servicesGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:gravity="center">

                <!-- Facial -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:src="@drawable/facial"
                        android:scaleType="centerCrop"
                        android:contentDescription="Facial Service"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Facial"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"/>

                    <Button
                        android:id="@+id/bookFacialBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Book Now"
                        android:background="@color/black"
                        android:textColor="@color/beige"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Haircut -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:src="@drawable/haircut"
                        android:scaleType="centerCrop"
                        android:contentDescription="Haircut Service"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Haircut"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"/>

                    <Button
                        android:id="@+id/bookHaircutBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Book Now"
                        android:background="@color/black"
                        android:textColor="@color/beige"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Beard Trim -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:src="@drawable/hottowel_shave"
                        android:scaleType="centerCrop"
                        android:contentDescription="Beard Trim Service"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Beard Trim"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"/>

                    <Button
                        android:id="@+id/bookBeardBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Book Now"
                        android:background="@color/black"
                        android:textColor="@color/beige"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Shave -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:src="@drawable/shave"
                        android:scaleType="centerCrop"
                        android:contentDescription="Shave Service"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shave"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginTop="4dp"/>

                    <Button
                        android:id="@+id/bookShaveBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Book Now"
                        android:background="@color/black"
                        android:textColor="@color/beige"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </GridLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>


    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:padding="12dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:weightSum="5">

        <!-- Book Appointment -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/bookAppointmentBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_appointment"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Book Appointment"
                app:tint="@color/black"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- My Bookings -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/myBookingsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_booking"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="My Bookings"
                app:tint="@color/black"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bookings"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Services -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/servicesBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_services"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Services"
                app:tint="@color/black"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Services"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Payments -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/paymentsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_payments"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Payments"
                app:tint="@color/black"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payments"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"/>
        </LinearLayout>


        <!-- Products -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/productsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_products"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Payments"
                app:tint="@color/black"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Products"
                android:textSize="12sp"
                android:textColor="#333333"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>


</RelativeLayout>
